**/*.quarto_ipynb

# Datos grillados pesados no considerados
*.nc
*.tif
*.tiff
# Excepción: recorte PISCOp v3 de la cuenca (5.9 MB); el nacional (1.5 GB) se ignora
!data/raw/pisco/PISCOp_v3_diario_Huancane.nc

