outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Datos procesados: cada participante los genera con los scripts del curso
data/processed/*
!data/processed/.gitkeep

# Solo para el Google Drive de los participantes (contiene datos de contacto)
LEEME_Instalacion.txt

# Restos de renders sueltos (el sitio usa docs/site_libs)
/site_libs/
